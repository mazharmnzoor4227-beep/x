<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.X" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/axion_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.X.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/axion_bg</item>
        <!-- Redesign round 2: no windowSplashScreenAnimatedIcon — the old
             axion_splash drawable was deleted with the cartoon logo, and
             without this item the system shows the launcher icon (the
             abstract ribbon mark, not a cartoon character) on the splash. -->
        <item name="postSplashScreenTheme">@style/Theme.X</item>
    </style>
</resources>
